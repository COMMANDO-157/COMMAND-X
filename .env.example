# Server only. Never prefix secrets with NEXT_PUBLIC_.
# Use a dedicated verified Free database; include sslmode=verify-full.
DATABASE_URL=
# A separate administrative connection used only for migrations/bootstrap.
DATABASE_ADMIN_URL=
# Generate at least 32 random bytes; never commit the real value.
SESSION_SECRET=
# Exact canonical deployment origin (or http://localhost:3000 for local work).
APP_ORIGIN=
